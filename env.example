# Example environment variables for local development
# Copy this file to .env and modify as needed

# Local PostgreSQL database URL (for Docker setup)
DATABASE_URL=postgresql://medimatch:medimatch123@localhost:5432/medimatchpro

# Alternative for local PostgreSQL installation
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/medimatchpro

# Development environment
NODE_ENV=development

# Session secret (change this in production)
SESSION_SECRET=your-session-secret-here-change-in-production

# App settings
PORT=5001 